# Environment Variables for AI-Powered Article Recommendation System
# Copy this file to .env and fill in your values

# ===========================================
# Database Credentials
# ===========================================
# MongoDB
MONGO_USER=recsys
MONGO_PASSWORD=your_mongodb_password_here
MONGO_DATABASE=recsys

# MariaDB (Vector Store)
MARIADB_ROOT_PASSWORD=your_mariadb_root_password_here
MARIADB_DATABASE=recsys_vectors
MARIADB_USER=recsys
MARIADB_PASSWORD=your_mariadb_password_here

# ===========================================
# LLM API Keys (Required for Summarization)
# ===========================================
# Groq API Key (Primary) - Get from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (Fallback) - Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ===========================================
# Embedding Model (Local ONNX)
# ===========================================
# Path to the ONNX model file (all-MiniLM-L6-v2)
# Download from: https://huggingface.co/sentence-transformers/all-MiniLM-L6-v2/tree/main/onnx
EMBEDDING_MODEL_PATH=/models/all-MiniLM-L6-v2.onnx
EMBEDDING_TOKENIZER_PATH=/models/tokenizer.json

# ===========================================
# Application Settings
# ===========================================
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080